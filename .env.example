# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Telegram user ID of the master (the only person with admin commands).
# You can get your ID by writing to @userinfobot.
MASTER_TG_ID=123456789

# Postgres connection string (e.g. Neon, Supabase, Railway).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Timezone for scheduling and reports (IANA name). Optional, defaults to Europe/Moscow.
TZ=Europe/Moscow
